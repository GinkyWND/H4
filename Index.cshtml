@model MyBusinessCard.Models.Person

@{
    ViewData["Title"] = "Моя визитка";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow" style="width: 24rem; border-radius: 15px; overflow: hidden;">
        <div class="card-header bg-primary text-white text-center py-4">
            <h3>Визитная карточка</h3>
        </div>
        <div class="card-body">
            <h4 class="card-title text-center mb-3">@Model.FullName</h4>
            
            <hr />
            
            <p class="card-text">
                <strong>Дата рождения:</strong> @Model.BirthDate.ToLongDateString()
            </p>
            <p class="card-text">
                <strong>Возраст:</strong> @Model.GetAge() лет
            </p>
            
            <p class="card-text">
                <strong>Обо мне:</strong><br />
                <span class="text-muted">@Model.Description</span>
            </p>
        </div>
        <div class="card-footer text-center bg-light">
            <a href="mailto:example@mail.com" class="btn btn-outline-primary btn-sm">Написать мне</a>
        </div>
    </div>
</div>
